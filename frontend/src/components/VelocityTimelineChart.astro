---
interface Props {
  anomalyDetected: boolean;
  anomalyType: string;
  growthMultiplier: number;
  timeline: Array<{ day: string; followers: number; daily_gain: number }>;
}

const {
  anomalyDetected = false,
  anomalyType = "ORGANIC_GROWTH",
  growthMultiplier = 1.0,
  timeline = []
} = Astro.props;

const maxGain = Math.max(...timeline.map(t => t.daily_gain), 100);
---

<div class="bg-white border border-hairline p-5 rounded-sm">
  <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-4 border-b border-hairline">
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-ink flex items-center gap-2">
        <span>Follower Velocity & Artificial Inflation Radar</span>
        {anomalyDetected && (
          <span class="text-[10px] font-black bg-live-red text-white px-2 py-0.5 rounded-xs uppercase tracking-tight">
            BOT INFLATION DETECTED
          </span>
        )}
      </div>
      <p class="text-xs text-slate mt-0.5">
        Analyzes 7-day velocity gradient for coordinated astroturfing and sudden follower buy-ins.
      </p>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono">
      <div class="px-2 py-1 bg-soft rounded-xs border border-hairline">
        <span class="text-slate text-[10px] block uppercase">Multiplier</span>
        <span class="font-bold text-ink">{growthMultiplier.toFixed(1)}x</span>
      </div>
      <div class="px-2 py-1 bg-soft rounded-xs border border-hairline">
        <span class="text-slate text-[10px] block uppercase">Velocity Pattern</span>
        <span class:list={["font-bold", anomalyDetected ? "text-live-red" : "text-emerald-700"]}>
          {anomalyType.replace(/_/g, ' ')}
        </span>
      </div>
    </div>
  </div>

  <!-- Velocity Timeline Visualization (DESIGN.md silver rail with timeline dots) -->
  <div class="space-y-3">
    <div class="relative pl-6 before:content-[''] before:absolute before:left-2 before:top-2 before:bottom-2 before:w-[2px] before:bg-silver">
      {timeline.map((point) => {
        const isSpike = point.daily_gain > 500;
        const barPct = Math.min(100, Math.round((point.daily_gain / maxGain) * 100));

        return (
          <div class="relative mb-3.5 last:mb-0">
            <!-- Timeline Dot -->
            <span
              class:list={[
                "absolute -left-6 top-1 w-3 h-3 rounded-full border-2 border-white",
                isSpike ? "bg-live-red ring-2 ring-red-200" : "bg-slate"
              ]}
            ></span>

            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs">
              <div class="flex items-center gap-2">
                <span class="font-mono font-bold text-ink text-[11px] w-16">{point.day}</span>
                <span class="text-slate">Total: <strong class="text-ink">{point.followers.toLocaleString()}</strong></span>
              </div>

              <div class="flex items-center gap-3 flex-1 max-w-xs">
                <!-- Bar representation -->
                <div class="w-full bg-soft h-2 rounded-xs overflow-hidden">
                  <div
                    class:list={[
                      "h-full transition-all duration-500",
                      isSpike ? "bg-live-red" : "bg-slate"
                    ]}
                    style={`width: ${barPct}%`}
                  ></div>
                </div>
                <span
                  class:list={[
                    "font-mono text-[11px] font-bold shrink-0 w-20 text-right",
                    isSpike ? "text-live-red" : "text-slate"
                  ]}
                >
                  +{point.daily_gain} /day
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
