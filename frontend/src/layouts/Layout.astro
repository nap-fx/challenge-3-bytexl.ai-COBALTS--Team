---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'intro' | 'social' | 'app-store' | 'brands' | 'history' | 'methodology';
}

const {
  title = "AegisMark AI — Autonomous Brand Impersonation & Rogue App Defense",
  description = "Multi-modal forensic detection against brand impersonation, rogue mobile APKs, synthetic bot reviews, and credential-harvesting scam campaigns.",
  activeTab
} = Astro.props;

const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/$/, '') + '/';
const currentPath = Astro.url.pathname;
const isIntro = activeTab === 'intro' || currentPath.includes('/intro');
const isBrands = activeTab === 'brands' || currentPath.includes('/brands');
const isHistory = activeTab === 'history' || currentPath.includes('/history');
const isMethodology = activeTab === 'methodology' || currentPath.includes('/methodology');
const isAppStore = activeTab === 'app-store' || currentPath.includes('/app-store');
const isSocial = activeTab === 'social' || (!isIntro && !isBrands && !isHistory && !isMethodology && !isAppStore);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf9f5" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Theme & Color Preference Script (Anti-FOUC) from dailyhabs -->
    <script is:inline>
      (function() {
        try {
          const savedTheme = localStorage.getItem('brandshield_theme');
          if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          const savedColor = localStorage.getItem('brandshield_color_theme') || 'terracotta';
          document.documentElement.setAttribute('data-color-theme', savedColor);
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts: Fraunces (Editorial Display Serif) + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#faf9f5] dark:bg-[#121110] text-[#4a4843] dark:text-[#c9c5bd] min-h-screen flex flex-col font-sans selection:bg-[#cc785c] selection:text-white transition-colors duration-250 relative overflow-x-hidden">
    
    <!-- Background Mouse Cursor Glow (Synced with Active Color Theme) -->
    <div id="bg-cursor-glow" class="bg-cursor-glow hidden md:block" aria-hidden="true"></div>

    <!-- Main Navigation Header (Claude Warm Canvas Style) -->
    <header class="bg-[#faf9f5]/90 dark:bg-[#121110]/90 backdrop-blur-md border-b border-[#e6dfd8] dark:border-[#24221e] sticky top-0 z-40 px-4 sm:px-8 py-3.5 transition-colors duration-250">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        
        <!-- Brand Wordmark & Icon -->
        <a href={baseUrl} class="flex items-center gap-3 group shrink-0">
          <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-[#cc785c] to-[#a9583e] text-white flex items-center justify-center shadow-md shadow-[#cc785c]/25 btn-3d-pop btn-3d-coral">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 2.18l7 3.12v4.7c0 4.54-3.14 8.79-7 9.88-3.86-1.09-7-5.34-7-9.88V6.3l7-3.12zm-1 5v6h2v-6h-2zm0 8v2h2v-2h-2z"/>
            </svg>
          </div>
          <div>
            <span class="font-serif text-2xl tracking-tight text-[#141413] dark:text-[#faf9f5] font-bold group-hover:text-accent transition-colors">AegisMark</span>
            <p class="text-[11px] text-[#78756d] dark:text-[#8e8b82] hidden lg:block font-medium">Digital Risk Protection</p>
          </div>
        </a>

        <!-- THE MAIN TABS (Interactive Multi-Page Nav with Generous Spacing) -->
        <nav class="flex items-center gap-1 sm:gap-2 bg-[#f4efe6] dark:bg-[#1c1b18] p-1.5 rounded-2xl border border-[#e6dfd8] dark:border-[#2d2b26] shadow-xs overflow-x-auto no-scrollbar" aria-label="Main Navigation">
          <a
            href={`${baseUrl}intro`}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isIntro
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <svg class="w-3.5 h-3.5 text-accent opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Introduction</span>
          </a>

          <a
            href={baseUrl}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isSocial
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <span>Social Scanner</span>
            {isSocial && <span class="w-1.5 h-1.5 rounded-full bg-[#cc785c]"></span>}
          </a>

          <a
            href={`${baseUrl}app-store`}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isAppStore
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <span>App Store</span>
          </a>

          <a
            href={`${baseUrl}brands`}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isBrands
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <span>Brands</span>
          </a>

          <a
            href={`${baseUrl}history`}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isHistory
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <span>Audit Vault</span>
          </a>

          <a
            href={`${baseUrl}methodology`}
            class:list={[
              "px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-bold tracking-tight transition-all duration-200 flex items-center gap-1.5 shrink-0 btn-3d-pop",
              isMethodology
                ? "bg-[#ffffff] dark:bg-[#252320] text-[#141413] dark:text-[#faf9f5] shadow-sm border border-[#e6dfd8]/60 dark:border-[#38352f]"
                : "text-[#78756d] dark:text-[#8e8b82] hover:text-[#141413] dark:hover:text-[#faf9f5]"
            ]}
          >
            <span>Methodology</span>
          </a>
        </nav>

        <!-- Right Controls: Vibrant Color Dots, 3D Theme Switcher, Backend Health Badge -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          
          <!-- 4 Vibrant Color Theme Switcher Dots -->
          <div class="hidden md:flex items-center gap-1.5 bg-[#f4efe6] dark:bg-[#1c1b18] p-1.5 rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] shadow-2xs" title="Select Vibrant Theme Color">
            <button data-color-theme="terracotta" class="color-theme-dot w-4 h-4 rounded-full bg-[#CC785C] border border-black/10 dark:border-white/20 transition-all btn-3d-pop" title="Original (Terracotta)"></button>
            <button data-color-theme="crimson" class="color-theme-dot w-4 h-4 rounded-full bg-[#F43F5E] border border-black/10 dark:border-white/20 transition-all btn-3d-pop" title="Vibrant Red (Crimson)"></button>
            <button data-color-theme="emerald" class="color-theme-dot w-4 h-4 rounded-full bg-[#10B981] border border-black/10 dark:border-white/20 transition-all btn-3d-pop" title="Vibrant Green (Emerald)"></button>
            <button data-color-theme="sapphire" class="color-theme-dot w-4 h-4 rounded-full bg-[#3B82F6] border border-black/10 dark:border-white/20 transition-all btn-3d-pop" title="Vibrant Blue (Sapphire)"></button>
          </div>

          <!-- 3D Physical Theme Switcher (Light / Dark) -->
          <button id="theme-toggle-btn" type="button" class="theme-switch-track btn-3d-pop shrink-0" title="Switch Light / Dark Mode" aria-label="Toggle theme">
            <span class="absolute left-1.5 top-1/2 -translate-y-1/2 text-xs select-none pointer-events-none opacity-80 dark:opacity-20">
              <svg class="w-3.5 h-3.5 text-[#e8a55a]" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"/></svg>
            </span>
            <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-xs select-none pointer-events-none opacity-20 dark:opacity-80">
              <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 20 20"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"/></svg>
            </span>
            <span id="theme-switch-knob" class="theme-switch-knob">
              <svg class="w-3.5 h-3.5 block dark:hidden text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              <svg class="w-3.5 h-3.5 hidden dark:block text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            </span>
          </button>

          <!-- Backend Telemetry Pill -->
          <div class="hidden xl:flex items-center gap-1.5 bg-[#f4efe6] dark:bg-[#1c1b18] px-3 py-1.5 rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] text-[11px] font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-[#78756d] dark:text-[#8e8b82]">API: <strong class="text-[#141413] dark:text-[#faf9f5]">ONLINE</strong></span>
          </div>
        </div>

      </div>
    </header>

    <!-- Main Content Body (Layered on top of cursor glow) -->
    <main class="relative z-10 flex-1 flex flex-col">
      <slot />
    </main>

    <!-- Claude Warm Editorial Footer -->
    <footer class="bg-[#f4efe6] dark:bg-[#181715] border-t border-[#e6dfd8] dark:border-[#24221e] mt-20 py-10 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-[#78756d] dark:text-[#8e8b82]">
        <div class="flex items-center gap-3">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-[#cc785c] to-[#a9583e] text-white flex items-center justify-center font-bold text-xs">
            B
          </div>
          <div>
            <strong class="text-[#141413] dark:text-[#faf9f5] font-serif text-sm">BrandShield AI</strong>
            <p class="text-[11px]">Multi-Modal Impersonation & Rogue App Forensic Platform</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 sm:gap-6 font-medium">
          <a href="/intro" class:list={["hover:text-accent transition-colors", isIntro ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>Introduction</a>
          <a href="/" class:list={["hover:text-accent transition-colors", isSocial ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>Social Scanner</a>
          <a href="/app-store" class:list={["hover:text-accent transition-colors", isAppStore ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>App Store Scanner</a>
          <a href="/brands" class:list={["hover:text-accent transition-colors", isBrands ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>Brand Registry</a>
          <a href="/history" class:list={["hover:text-accent transition-colors", isHistory ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>Audit Vault</a>
          <a href="/methodology" class:list={["hover:text-accent transition-colors", isMethodology ? "text-accent font-bold" : "text-[#78756d] dark:text-[#8e8b82]"]}>Forensic Architecture</a>
          <a href="http://127.0.0.1:8000/docs" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors flex items-center gap-1">
            <span>FastAPI Docs</span>
            <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
          <span class="text-[#e6dfd8] dark:text-[#2d2b26] hidden md:inline">|</span>
          <span class="font-mono text-[11px]">COBALTS 3 CHALLENGE</span>
        </div>
      </div>
    </footer>

    <!-- Reactive Cursor Glow Script from dailyhabs -->
    <script is:inline>
      (function() {
        if (window.matchMedia('(pointer: fine)').matches) {
          const glow = document.getElementById('bg-cursor-glow');
          if (!glow) return;

          let mouseX = -200;
          let mouseY = -200;
          let glowX = -200;
          let glowY = -200;

          window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
          });

          function animateGlow() {
            glowX += (mouseX - glowX) * 0.12;
            glowY += (mouseY - glowY) * 0.12;

            glow.style.left = glowX + 'px';
            glow.style.top = glowY + 'px';

            requestAnimationFrame(animateGlow);
          }
          requestAnimationFrame(animateGlow);
        }

        // Theme Toggle Listener
        const themeToggleBtn = document.getElementById('theme-toggle-btn');
        themeToggleBtn?.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('brandshield_theme', isDark ? 'dark' : 'light');
        });

        // Color Theme Switcher Dots
        document.querySelectorAll('.color-theme-dot').forEach(btn => {
          btn.addEventListener('click', () => {
            const theme = btn.getAttribute('data-color-theme') || 'terracotta';
            document.documentElement.setAttribute('data-color-theme', theme);
            localStorage.setItem('brandshield_color_theme', theme);
          });
        });
      })();
    </script>
  </body>
</html>
