---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout
  title="AegisMark AI — Introduction & Multi-Page Platform Hub"
  description="Executive overview, architectural pipeline, and direct interactive directory to all AegisMark AI forensic scanners, SOC brand registries, and investigation archives."
  activeTab="intro"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-8 space-y-12">

    <!-- 1. EDITORIAL HERO & PLATFORM EXECUTIVE OVERVIEW -->
    <section class="border-b border-[#e6dfd8] dark:border-[#24221e] pb-10 space-y-6">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-6 bg-accent rounded-full inline-block"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-[#78756d] dark:text-[#8e8b82] font-mono">
          HACXLERATE 2026 // CHALLENGE 3 PLATFORM DIRECTORY
        </span>
      </div>

      <div class="max-w-4xl space-y-4">
        <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#141413] dark:text-[#faf9f5] leading-[1.12]">
          Autonomous Digital Risk Protection & Brand Defense Mesh
        </h1>
        <p class="text-base sm:text-lg text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
          Engineered for <strong class="text-[#141413] dark:text-[#faf9f5]">Kampus.vc</strong> and <strong class="text-[#141413] dark:text-[#faf9f5]">ByteXL</strong> to safeguard university students, academic partners, and enterprise tech ecosystems from predatory campus placement rackets, clone social accounts, and rogue mobile APK syndicates.
        </p>
      </div>

      <!-- Live SOC Health & Telemetry Banner -->
      <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] p-5 rounded-3xl shadow-xs flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
        <div class="flex items-center gap-3">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <div>
            <span class="text-[10px] text-[#78756d] uppercase block font-sans">Core Defense Engine</span>
            <strong class="text-[#141413] dark:text-[#faf9f5] text-sm">OPERATIONAL & ONLINE</strong>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-[11px] text-[#78756d] dark:text-[#8e8b82]">
          <div>VISION: <strong class="text-[#141413] dark:text-[#faf9f5]">FAISS (512-d CLIP)</strong></div>
          <div>NLP: <strong class="text-[#141413] dark:text-[#faf9f5]">DistilBERT ScamIntent</strong></div>
          <div>HEURISTICS: <strong class="text-[#141413] dark:text-[#faf9f5]">Wagner-Fischer + Homoglyphs</strong></div>
          <div>AUDIT STORAGE: <strong class="text-[#141413] dark:text-[#faf9f5]">SQLite Persistent</strong></div>
        </div>
      </div>

      <!-- Neural Engine Development Status Notice -->
      <div class="p-4 sm:p-5 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-900 dark:text-amber-200 flex items-start gap-3.5 text-xs sm:text-sm">
        <span class="text-lg">ℹ️</span>
        <div>
          <strong class="font-bold block text-amber-800 dark:text-amber-300 mb-1">Architecture & Model Staging Notice:</strong>
          <span>The backend is actively under continuous development. Full real-world deep neural network weights (512-d fine-tuned CLIP embeddings, full-scale OCR tensor inference, and domain transformer models) are currently undergoing extensive multi-epoch dataset training and GPU cluster fine-tuning. The live demo executes on high-throughput lexical extractors, heuristic manifolds, and pre-computed vector indexes for immediate hackathon verification.</span>
        </div>
      </div>
    </section>

    <!-- 2. DIRECT MULTI-PAGE DIRECTORY & INTERACTIVE LAUNCHPAD -->
    <section class="space-y-6">
      <SectionHeader
        eyebrow="PLATFORM NAVIGATION"
        title="Direct Multi-Page Forensic Modules"
        subtitle="Click any module card below to launch the corresponding diagnostic scanner, browse enterprise assets, or inspect past investigation dossiers."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- Card 1: Social Media Threat Scanner (Tab 1) -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#cc785c]/15 text-[#cc785c] border border-[#cc785c]/30">
                Primary Module // Tab 01
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">/</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#cc785c] to-[#a9583e] text-white flex items-center justify-center shadow-md shadow-[#cc785c]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              Social Media Threat Scanner
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Instant investigation link paster for Instagram, X, and Telegram profiles. Decomposes handle slugs, strips zero-width evasion characters, runs the 3 diagnostic pillars, and renders media OCR extracts and voiceover transcripts.
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Image OCR Graphic Extraction</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Audio Voiceover Speech Forensics</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>5-Surface Cross-Platform OSINT</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>1-Click Signed DMCA Takedown</span>
              </li>
            </ul>
          </div>

          <a
            href="/"
            class="w-full bg-[#cc785c] hover:bg-[#b86348] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#cc785c]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop btn-3d-coral cursor-pointer"
          >
            <span>Launch Social Threat Scanner</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 2: 5-Pillar App Store Forensic Engine (Tab 2) -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#3b82f6]/15 text-[#3b82f6] border border-[#3b82f6]/30">
                Mobile Security // Tab 02
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">/app-store</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#3b82f6] to-[#2563eb] text-white flex items-center justify-center shadow-md shadow-[#3b82f6]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              5-Pillar App Store Scanner
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Deep mobile app and APK triage engine. Exposes rogue developer rings, coordinates AI bot review burst astroturfing within tight 48-hr windows, catches polarized U-curve rating splits, and detects dangerous SMS permissions.
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Pillar 1: AI Bot Review Probability</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Pillar 2: Astroturfing Burst Window</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Pillar 3: Publisher Reverse OSINT</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Pillars 4-5: Polarization + SMS Perms</span>
              </li>
            </ul>
          </div>

          <a
            href="/app-store"
            class="w-full bg-[#3b82f6] hover:bg-[#2563eb] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#3b82f6]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop cursor-pointer"
          >
            <span>Launch App Store Scanner</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 3: Protected Enterprise Brand Directory -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#10b981]/15 text-[#10b981] border border-[#10b981]/30">
                Asset Inventory // Page 03
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">/brands</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#10b981] to-[#059669] text-white flex items-center justify-center shadow-md shadow-[#10b981]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              Protected Brand Registry
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              SOC inventory of cryptographically registered enterprise trademarks. Houses official social handles, whitelisted root domains, verified publisher entities, and official Android/iOS package bundles for 100% false-positive immunity.
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>ByteXL & Kampus.vc Profiles</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Zomato, Paytm, Zerodha, Amazon</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Whitelisted Mobile App Packages</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Self-Service Brand Enrollment</span>
              </li>
            </ul>
          </div>

          <a
            href="/brands"
            class="w-full bg-[#10b981] hover:bg-[#059669] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#10b981]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop cursor-pointer"
          >
            <span>Explore Brand Registry</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 4: Forensic Investigation Archive & Audit Trail -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#8b5cf6]/15 text-[#8b5cf6] border border-[#8b5cf6]/30">
                Audit Vault // Page 04
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">/history</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#8b5cf6] to-[#7c3aed] text-white flex items-center justify-center shadow-md shadow-[#8b5cf6]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              Investigation Archive
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Immutable chain of custody storing every forensic scan performed by the system. Persists complete telemetry, detected violations, calculated pillar scores, and generated takedown legal notices in a local SQLite database (`scans_audit.db`).
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Unique CASE-ID Chain of Custody</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Severity Filter (Critical / High / Safe)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Persistent SQLite Telemetry</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Exportable Incident Evidence</span>
              </li>
            </ul>
          </div>

          <a
            href="/history"
            class="w-full bg-[#8b5cf6] hover:bg-[#7c3aed] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#8b5cf6]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop cursor-pointer"
          >
            <span>Inspect Audit Vault</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 5: Neural Architecture & Methodology -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#f59e0b]/15 text-[#f59e0b] border border-[#f59e0b]/30">
                Technical Dossier // Page 05
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">/methodology</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#f59e0b] to-[#d97706] text-white flex items-center justify-center shadow-md shadow-[#f59e0b]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              Forensic Methodology
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Complete technical documentation of the multi-modal detection engine. Details the mathematical formulation of 512-dim CLIP embeddings, DistilBERT scam intent classification, Wagner-Fischer edit distance, and the unified 4-part scoring formula.
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Mathematical Formulation Breakdown</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Adversarial Unicode Deobfuscation</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>5-Pillar App Store Algorithm</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>Unified Threat Scoring Weight Matrix</span>
              </li>
            </ul>
          </div>

          <a
            href="/methodology"
            class="w-full bg-[#f59e0b] hover:bg-[#d97706] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#f59e0b]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop cursor-pointer"
          >
            <span>Read Technical Dossier</span>
            <span>→</span>
          </a>
        </div>

        <!-- Card 6: Live API Telemetry & Health Probe -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase bg-[#14b8a6]/15 text-[#14b8a6] border border-[#14b8a6]/30">
                REST API Backend // Endpoint 06
              </span>
              <span class="text-xs font-mono text-[#78756d]">URL: <code class="text-accent">:8000/docs</code></span>
            </div>

            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#14b8a6] to-[#0f766e] text-white flex items-center justify-center shadow-md shadow-[#14b8a6]/25">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>

            <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
              FastAPI Interactive Docs
            </h3>

            <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Explore the live Swagger OpenAPI documentation for all AegisMark backend endpoints. Test raw requests for URL extraction, profile scanning, app store review forensics, and automated PDF DMCA generation.
            </p>

            <ul class="space-y-2 text-xs font-mono text-[#78756d] dark:text-[#8e8b82] pt-2">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>POST /api/v1/scan</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>POST /api/v1/extract-link</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>POST /api/v1/scan/app-store</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500 font-bold">✓</span> <span>GET /api/v1/health</span>
              </li>
            </ul>
          </div>

          <a
            href="http://127.0.0.1:8000/docs"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-[#14b8a6] hover:bg-[#0f766e] text-white text-xs sm:text-sm font-bold py-3.5 px-6 rounded-2xl shadow-md shadow-[#14b8a6]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop cursor-pointer"
          >
            <span>Open Swagger API Docs ↗</span>
          </a>
        </div>

      </div>
    </section>

    <!-- 3. VISUAL ARCHITECTURE PIPELINE -->
    <section class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 sm:p-10 shadow-sm space-y-8">
      <SectionHeader
        eyebrow="PIPELINE WORKFLOW"
        title="How AegisMark AI Operates in Real Time"
        subtitle="End-to-end telemetry lifecycle from suspect link ingestion to legal cease-and-desist execution."
      />

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 relative">
        <!-- Step 1 -->
        <div class="p-5 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] space-y-3">
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-accent/15 text-accent uppercase">Step 01</span>
          <h4 class="font-serif text-lg font-bold text-[#141413] dark:text-[#faf9f5]">Ingestion & Extraction</h4>
          <p class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
            Deconstructs raw profile URLs or store links. Strips query parameters, extracts handle slugs, and normalizes zero-width unicode evasion characters.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="p-5 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] space-y-3">
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#3b82f6]/15 text-[#3b82f6] uppercase">Step 02</span>
          <h4 class="font-serif text-lg font-bold text-[#141413] dark:text-[#faf9f5]">Parallel Triad Inference</h4>
          <p class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
            Simultaneously computes 512-dim CLIP logo embeddings, DistilBERT scam intent on bio/posts, and Wagner-Fischer homoglyph edit distance metrics.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="p-5 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] space-y-3">
          <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded-full bg-[#10b981]/15 text-[#10b981] uppercase">Step 03</span>
