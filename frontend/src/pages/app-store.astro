</Layout>

<script>
  import { apiFetch } from '../lib/api';

  const appForm = document.getElementById('app-scan-form') as HTMLFormElement;
  const linkInput = document.getElementById('app_link_input') as HTMLInputElement;
  const titleInput = document.getElementById('app_title_input') as HTMLInputElement;
  const storeSelect = document.getElementById('app_store_select') as HTMLSelectElement;
  const iconInput = document.getElementById('icon-file-input') as HTMLInputElement;
  const runBtn = document.getElementById('run-scan-btn') as HTMLButtonElement;
  const spinner = document.getElementById('scan-spinner');
  const btnText = document.getElementById('scan-btn-text');
  const openTakedownBtn = document.getElementById('open-takedown-btn');
  const takedownModal = document.getElementById('takedown-modal');

  // Handle image upload preview
  iconInput?.addEventListener('change', () => {
    const file = iconInput.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const preview = document.getElementById('image-preview');
        const uploadLabel = document.getElementById('upload-label');
        if (preview && e.target?.result) {
          preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover rounded-xl" alt="App Icon" />`;
        }
        if (uploadLabel) {
          uploadLabel.textContent = `✓ ${file.name}`;
        }
      };
      reader.readAsDataURL(file);
    }
  });

  // Presets
  const btnRogueByteXL = document.getElementById('preset-rogue-bytexl');
  const btnSideloadApk = document.getElementById('preset-sideload-apk');
  const btnOfficialApp = document.getElementById('preset-official-app');

  btnRogueByteXL?.addEventListener('click', () => {
    titleInput.value = 'ByteXL Placement Exam & Student Desk';
    linkInput.value = 'https://play.google.com/store/apps/details?id=com.bytexl.placement.guide';
    storeSelect.value = 'Google Play';
    appForm.requestSubmit();
  });

  btnSideloadApk?.addEventListener('click', () => {
    titleInput.value = 'ByteXL Exam Prep Cracked APK';
    linkInput.value = 'https://bytexl-exam.en.uptodown.com/android';
    storeSelect.value = 'Uptodown';
    appForm.requestSubmit();
  });

  btnOfficialApp?.addEventListener('click', () => {
    titleInput.value = 'ByteXL Student Learning Portal';
    linkInput.value = 'https://play.google.com/store/apps/details?id=com.bytexl.learning';
    storeSelect.value = 'Google Play';
    appForm.requestSubmit();
  });

  function autoDetectBrand(str: string): string {
    const lower = str.toLowerCase();
    if (lower.includes('zomato')) return 'Zomato';
    if (lower.includes('paytm')) return 'Paytm';
    if (lower.includes('zerodha')) return 'Zerodha';
    return 'ByteXL';
  }

  appForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (spinner && btnText) {
      spinner.classList.remove('hidden');
      btnText.classList.add('hidden');
    }
    if (runBtn) runBtn.disabled = true;

    // Parse package id from link if present
    const rawLink = linkInput.value.trim();
    let packageId = "com.bytexl.placement.guide";
    if (rawLink.includes('id=')) {
      packageId = rawLink.split('id=')[1].split('&')[0];
    } else if (rawLink.includes('.')) {
      packageId = rawLink.replace(/https?:\/\/[^\/]+\//, '').replace(/\//g, '.');
    }

    const appTitle = titleInput.value.trim() || 'Mobile App';
    const brandName = autoDetectBrand(`${rawLink} ${appTitle}`);

    const payload = {
      brand_name: brandName,
      app_title: appTitle,
      package_id: packageId,
      publisher_name: null, // Let backend automatically resolve based on package whitelist or rogue developer signature
      store: storeSelect.value,
      permissions_requested: [
        "android.permission.INTERNET",
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS"
      ]
    };

    try {
      const data = await apiFetch<any>('/api/v1/scan/app-store', {
        method: 'POST',
        body: JSON.stringify(payload)
      });
      // Clear error banner on success
      document.getElementById('app-scan-error-banner')?.classList.add('hidden');
      renderAppDossier(data);
    } catch (err: any) {
      console.error("App store backend error:", err);
      const errBanner = document.getElementById('app-scan-error-banner');
      const errMsg = document.getElementById('app-scan-error-message');
      if (errBanner && errMsg) {
        errMsg.textContent = `App Store Scan failed: ${err.message || 'Unable to connect to AegisMark AI backend at http://127.0.0.1:8000.'}`;
        errBanner.classList.remove('hidden');
        errBanner.scrollIntoView({ behavior: 'smooth' });
      }
    } finally {
      if (spinner && btnText) {
        spinner.classList.add('hidden');
        btnText.classList.remove('hidden');
      }
      if (runBtn) runBtn.disabled = false;
    }
  });

  // Close error banner handler
  document.getElementById('close-app-error-banner')?.addEventListener('click', () => {
    document.getElementById('app-scan-error-banner')?.classList.add('hidden');
  });

  function renderAppDossier(data: any) {
    const resultsSec = document.getElementById('app-results-section');
    resultsSec?.scrollIntoView({ behavior: 'smooth' });

    (document.getElementById('app-case-id') as HTMLElement).textContent = data.scan_id;
    (document.getElementById('app-threat-index') as HTMLElement).textContent = Math.round(data.app_threat_index).toFixed(1);
    (document.getElementById('app-recommended-action') as HTMLElement).textContent = data.recommended_action;
    (document.getElementById('res-store-name') as HTMLElement).textContent = data.store;
    (document.getElementById('res-app-title') as HTMLElement).textContent = data.app_title;
    (document.getElementById('res-publisher-name') as HTMLElement).textContent = data.publisher_name;
    (document.getElementById('res-package-id') as HTMLElement).textContent = data.app_package_id;

    const isSafe = data.is_official_app || data.app_threat_index < 30;

    // Severity & Threat Index formatting
    const threatIdxElem = document.getElementById('app-threat-index');
    if (threatIdxElem) {
      threatIdxElem.className = `font-serif text-6xl sm:text-7xl font-bold tracking-tight ${
        isSafe ? 'text-[#5db872]' : 'text-[#c64545] dark:text-[#f87171]'
      }`;
    }

    const sevBadge = document.getElementById('app-severity-badge') as HTMLElement;
    if (sevBadge) {
      sevBadge.textContent = `${data.severity_level.replace(/_/g, ' ')} THREAT LEVEL`;
      sevBadge.className = `px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl inline-block w-full border ${
        data.severity_level === 'CRITICAL'
          ? 'bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border-red-200 dark:border-red-900'
          : data.severity_level === 'HIGH'
          ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-900'
          : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900'
      }`;
    }

    // Publisher Alert Banner
    const alertBanner = document.getElementById('publisher-mismatch-banner');
    if (alertBanner) {
      if (data.publisher_mismatch_alert) {
        alertBanner.classList.remove('hidden');
        (document.getElementById('publisher-alert-text') as HTMLElement).textContent = data.publisher_mismatch_alert;
      } else {
        alertBanner.classList.add('hidden');
      }
    }

    // Pillar 1: AI Bot Reviews
    const p1Bot = data.review_forensics?.bot_probability_pct ?? 0;
    const p1Score = document.getElementById('p1-bot-score');
    if (p1Score) {
      p1Score.textContent = `${p1Bot.toFixed(1)}% AI`;
      p1Score.className = `font-serif text-xl font-bold ${p1Bot >= 50 ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }
    const p1Pattern = document.getElementById('p1-bot-pattern');
    if (p1Pattern) {
      p1Pattern.textContent = data.review_forensics?.hyperbolic_praise_detected ? 'Synthesized Praise' : 'Organic Reviews';
      p1Pattern.className = p1Bot >= 50 ? 'text-[#c64545]' : 'text-[#5db872]';
    }

    // Pillar 2: Velocity
    const p2Burst = document.getElementById('p2-burst-score');
    if (p2Burst) {
      p2Burst.textContent = `${data.review_forensics?.temporal_burst_window_hours || 0}h Window`;
      p2Burst.className = `font-serif text-xl font-bold ${data.review_forensics?.astroturfing_burst_detected ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }
    const p2Pattern = document.getElementById('p2-burst-pattern');
    if (p2Pattern) {
      p2Pattern.textContent = data.review_forensics?.astroturfing_burst_detected ? 'Coordinated Campaign' : 'Organic Velocity';
      p2Pattern.className = data.review_forensics?.astroturfing_burst_detected ? 'text-[#c64545]' : 'text-[#5db872]';
    }

    // Pillar 3: Developer OSINT
    const p3Score = document.getElementById('p3-pub-score');
    if (p3Score) {
      p3Score.textContent = `${data.publisher_portfolio?.average_app_lifespan_days || 0}d avg lifespan`;
      p3Score.className = `font-serif text-xl font-bold ${isSafe ? 'text-[#5db872]' : 'text-[#c64545]'}`;
    }
    const p3Pattern = document.getElementById('p3-pub-pattern');
    if (p3Pattern) {
      p3Pattern.textContent = isSafe ? 'Verified Enterprise' : 'Burner Syndicate';
      p3Pattern.className = isSafe ? 'text-[#5db872]' : 'text-[#c64545]';
    }

    // Pillar 4: Bimodal Ratings
    const split = data.review_forensics?.rating_bimodal_split || { "5_star": 0, "4_star": 0, "3_star": 0, "2_star": 0, "1_star": 0 };
    const totalRev = data.review_forensics?.total_reviews_analyzed || 1;
    (document.getElementById('p4-total-reviews') as HTMLElement).textContent = totalRev.toLocaleString();

    const p4Status = document.getElementById('p4-bimodal-status');
    if (p4Status) {
      if (isSafe) {
        p4Status.textContent = "BALANCED RATINGS";
        p4Status.className = "text-[10px] font-bold bg-[#5db872]/15 text-[#5db872] border border-[#5db872]/30 px-2 py-0.5 rounded-full uppercase";
      } else {
        p4Status.textContent = "POLARIZED U-CURVE";
        p4Status.className = "text-[10px] font-bold bg-[#c64545]/15 text-[#c64545] border border-[#c64545]/30 px-2 py-0.5 rounded-full uppercase";
      }
    }

    // Update rating bars dynamically
    const maxBar = Math.max(split["5_star"] || 0, split["1_star"] || 0, split["4_star"] || 0, 1);
    const updateBar = (starKey: string, elemPrefix: string) => {
      const count = split[starKey] || 0;
      const pct = Math.round((count / totalRev) * 100);
      const barW = Math.round((count / maxBar) * 100);
      const barElem = document.getElementById(`bar-${elemPrefix}`);
      const countElem = document.getElementById(`count-${elemPrefix}`);
      const pctElem = document.getElementById(`pct-${elemPrefix}`);
      if (barElem) barElem.style.width = `${barW}%`;
      if (countElem) countElem.textContent = count.toLocaleString();
      if (pctElem) pctElem.textContent = `(${pct}%)`;
    };
    updateBar("5_star", "5star");
    updateBar("4_star", "4star");
    updateBar("3_star", "3star");
    updateBar("2_star", "2star");
    updateBar("1_star", "1star");

    // Pillar 5: Permissions Risk
    const p5Score = document.getElementById('p5-perm-score');
    if (p5Score) {
      p5Score.textContent = `${data.permissions_risk_score.toFixed(0)}% Risk`;
      p5Score.className = `font-serif text-xl font-bold ${data.permissions_risk_score > 30 ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }
    const p5Exploit = document.getElementById('p5-perm-exploit');
    if (p5Exploit) {
      p5Exploit.textContent = data.flagged_permissions?.length > 0 ? `${data.flagged_permissions.length} High-Risk Perms` : 'Zero Dangerous Perms';
      p5Exploit.className = data.flagged_permissions?.length > 0 ? 'text-[#c64545]' : 'text-[#5db872]';
    }
    const smsPermsElem = document.getElementById('res-sms-perms');
    if (smsPermsElem) {
      smsPermsElem.textContent = data.flagged_permissions?.length > 0 ? data.flagged_permissions.join(' + ') : 'None (Safe Sandbox)';
      smsPermsElem.className = data.flagged_permissions?.length > 0 ? 'font-bold text-[#c64545] truncate block' : 'font-bold text-[#5db872] truncate block';
    }

    // Render Review Citations & Victim Complaints
    const snippetsContainer = document.getElementById('res-review-snippets');
    const snippetsCount = document.getElementById('snippets-count');
    if (snippetsContainer) {
      const snippets = data.review_forensics?.flagged_review_snippets || [];
      if (snippetsCount) snippetsCount.textContent = `${snippets.length} Citations Indexed`;
      if (snippets.length > 0) {
        snippetsContainer.innerHTML = snippets.map((s: string) => {
          const isVictim = s.toLowerCase().includes('victim') || s.toLowerCase().includes('fraud') || s.toLowerCase().includes('1-star');
          return `
            <div class="p-3.5 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border-l-4 ${isVictim ? 'border-[#c64545]' : 'border-[#e8a55a]'} text-xs font-mono text-[#141413] dark:text-[#faf9f5] space-y-1">
              <span class="text-[10px] uppercase font-bold ${isVictim ? 'text-[#c64545]' : 'text-[#e8a55a]'} block">
                ${isVictim ? '🚨 Authentic Victim Fraud Report (1-Star)' : '🤖 Coordinated LLM Bot Synthesis (5-Star Cluster)'}
              </span>
              <p class="leading-relaxed">${s}</p>
            </div>
          `;
        }).join('');
      } else {
        snippetsContainer.innerHTML = `
          <div class="p-4 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] text-xs font-mono text-[#5db872]">
            ✓ Zero suspicious bot clusters or victim fraud reports detected. Genuine organic store distribution.
          </div>
        `;
      }
    }

    // Render Discovered Developer Portfolio Apps
    const portfolioContainer = document.getElementById('res-portfolio-apps');
    const repBadge = document.getElementById('portfolio-reputation-badge');
    if (portfolioContainer) {
      const apps = data.publisher_portfolio?.portfolio_apps || [];
      if (repBadge) {
        repBadge.textContent = data.publisher_portfolio?.reputation_status.replace(/_/g, ' ') || 'UNKNOWN';
        repBadge.className = `px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase border ${
          isSafe
            ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900'
            : 'bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border-red-200 dark:border-red-900'
        }`;
      }
      if (apps.length > 0) {
        portfolioContainer.innerHTML = apps.map((app: any) => `
          <div class="p-3.5 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] flex flex-col justify-between space-y-2 card-lift">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                <span class="text-[#78756d]">★ ${app.rating}</span>
                <span class="px-1.5 py-0.2 rounded text-[9px] font-bold ${app.status === 'VERIFIED' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}">
                  ${app.status}
                </span>
              </div>
              <h5 class="font-bold text-xs text-[#141413] dark:text-[#faf9f5] line-clamp-1">${app.app_title}</h5>
              <div class="text-[10px] font-mono text-[#78756d] truncate mt-0.5">${app.package_id}</div>
            </div>
          </div>
        `).join('');
      } else {
        portfolioContainer.innerHTML = `<div class="col-span-full py-4 text-xs font-mono text-[#78756d]">No associated sister apps discovered.</div>`;
      }
    }

    // Takedown Strike Button status
    const takedownBtn = document.getElementById('open-takedown-btn') as HTMLButtonElement;
    if (takedownBtn) {
      if (!isSafe) {
        takedownBtn.disabled = false;
        takedownBtn.className = "bg-[#c64545] hover:bg-[#a83636] text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-2xl shadow-md transition-all flex items-center gap-2 btn-3d-pop cursor-pointer opacity-100";
        takedownBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>1-Click App Store Abuse Strike</span>
        `;
      } else {
        takedownBtn.disabled = true;
        takedownBtn.className = "bg-[#78756d]/30 text-[#78756d] text-xs sm:text-sm font-bold px-5 py-2.5 rounded-2xl transition-all flex items-center gap-2 cursor-not-allowed opacity-60";
        takedownBtn.innerHTML = `
          <svg class="w-4 h-4 text-[#5db872]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Official App (Strike Inactive)</span>
        `;
      }
    }

    // Configure strike package text
    if (!isSafe) {
      const strikeText = `GOOGLE PLAY DEVELOPER ABUSE REPORT & TRADEMARK IMPERSONATION NOTICE
Date: ${new Date().toUTCString()}
Ref: GP-STRIKE-${data.scan_id}
Notice To: Google Play Developer Support, Policy Enforcement Team

VIOLATING APP INFORMATION:
- App Title: ${data.app_title}
- Package Name: ${data.app_package_id}
- Declared Publisher: ${data.publisher_name}
- Store: ${data.store}
- App Threat Index: ${data.app_threat_index}/100 (${data.severity_level})

POLICY INFRINGEMENT CITATIONS:
1. Google Play Developer Program Policy - Impersonation (Section 1.3):
   Unauthorized commercial reproduction of trademarked brand assets.
2. Synthetic Bot Reviews Astroturfing:
   Astroturfed review clusters artificially inflating store rating (${data.review_forensics?.bot_probability_pct}% AI probability) while masking victim complaints.
3. Intrusive Permission Harvesting:
   Dangerous requests for ${(data.flagged_permissions || []).join(', ')} without functional pedagogical justification.

MANDATORY ACTION DEMANDED:
Immediate suspension of package ${data.app_package_id} and audit of developer account ${data.publisher_name}.

Submitted by: AegisMark AI Cyber Operations`;

      const modalTextarea = document.getElementById('modal-takedown-text') as HTMLTextAreaElement;
      if (modalTextarea) modalTextarea.value = strikeText;
      const modalCaseId = document.getElementById('modal-case-id') as HTMLElement;
      if (modalCaseId) modalCaseId.textContent = `GP-STRIKE-${data.scan_id}`;
    }
  }

  openTakedownBtn?.addEventListener('click', () => {
    const takedownBtn = document.getElementById('open-takedown-btn') as HTMLButtonElement;
    if (takedownBtn && !takedownBtn.disabled) {
      takedownModal?.classList.remove('hidden');
    }
  });
</script>
