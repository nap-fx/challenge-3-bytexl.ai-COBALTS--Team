---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import RatingBimodalChart from '../components/RatingBimodalChart.astro';
import TakedownModal from '../components/TakedownModal.astro';
---

<Layout title="AegisMark AI — 5-Pillar App Store & Mobile APK Scanner" activeTab="app-store">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6 pb-16 space-y-12">

    <!-- 1. EDITORIAL HEADER (dailyhabs warm canvas style) -->
    <div class="relative rounded-3xl bg-gradient-to-br from-[#ffffff] via-[#fbf9f4] to-[#f4efe6] dark:from-[#181715] dark:via-[#1c1b18] dark:to-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] p-8 sm:p-12 shadow-xl overflow-hidden">
      <!-- Accent Glow Orbs -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-[#cc785c]/15 dark:bg-[#cc785c]/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#cc785c]/10 dark:bg-[#cc785c]/20 border border-[#cc785c]/30 text-[#cc785c] text-xs font-bold uppercase tracking-wider mb-5 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
          <span>5-Pillar Mobile APK Forensics</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-[#141413] dark:text-[#faf9f5] leading-[1.15]">
          App Store & Rogue APK <br />
          <span class="text-[#cc785c] italic">Forensic Investigator</span>
        </h1>

        <p class="text-sm sm:text-base text-[#78756d] dark:text-[#8e8b82] mt-3 font-medium leading-relaxed max-w-2xl">
          Audit Google Play Store listings and third-party sideloaded APK mirrors (Uptodown, APKMirror). The backend algorithm calculates synthetic bot review bursts, publisher burner rings, and invasive SMS permissions.
        </p>

        <!-- Quick Info Badges -->
        <div class="flex flex-wrap items-center gap-3 mt-6 text-xs font-semibold text-[#78756d] dark:text-[#8e8b82]">
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-[#5db872]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> Google Play & Third-Party Mirrors</span>
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-[#cc785c]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> Bimodal U-Curve Analysis</span>
          <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-[#3b82f6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Automated Abuse Strike</span>
        </div>
      </div>
    </div>

    <!-- 2. SCANNER INPUT CONFIGURATION CARD -->
    <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 sm:p-8 shadow-md">
      <form id="app-scan-form" class="space-y-6">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Store Link or Package ID Input -->
          <div>
            <label for="app_link_input" class="block text-xs font-bold uppercase tracking-wider text-[#141413] dark:text-[#faf9f5] mb-2 font-sans">
              Store URL, Mirror Link, or Package Name
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#78756d]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </div>
              <input
                type="text"
                id="app_link_input"
                value="https://play.google.com/store/apps/details?id=com.bytexl.placement.guide"
                placeholder="e.g. https://play.google.com/store/apps/details?id=... or com.bytexl.placement.guide"
                class="w-full bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] pl-10 pr-4 py-3.5 rounded-2xl font-mono text-xs sm:text-sm text-[#141413] dark:text-[#faf9f5] outline-none focus:border-[#cc785c] transition-colors"
              />
            </div>
          </div>

          <!-- App Title / Name -->
          <div>
            <label for="app_title_input" class="block text-xs font-bold uppercase tracking-wider text-[#141413] dark:text-[#faf9f5] mb-2 font-sans">
              Application Title (Search Override)
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#78756d]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              </div>
              <input
                type="text"
                id="app_title_input"
                value="ByteXL Placement Exam & Student Desk"
                placeholder="e.g. ByteXL Placement Guide"
                class="w-full bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] pl-10 pr-4 py-3.5 rounded-2xl font-mono text-xs sm:text-sm text-[#141413] dark:text-[#faf9f5] outline-none focus:border-[#cc785c] transition-colors"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Store Origin Selector -->
          <div>
            <label for="app_store_select" class="block text-xs font-bold uppercase tracking-wider text-[#141413] dark:text-[#faf9f5] mb-2 font-sans">
              Distribution Store / Repository
            </label>
            <select
              id="app_store_select"
              class="w-full bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] px-4 py-3.5 rounded-2xl font-mono text-xs sm:text-sm text-[#141413] dark:text-[#faf9f5] outline-none focus:border-[#cc785c] transition-colors cursor-pointer"
            >
              <option value="Google Play">Google Play Store</option>
              <option value="Uptodown">Uptodown (Third-Party Sideload)</option>
              <option value="APKMirror">APKMirror (Third-Party Sideload)</option>
              <option value="APKPure">APKPure (Third-Party Sideload)</option>
              <option value="Apple App Store">Apple App Store (iOS)</option>
            </select>
          </div>

          <!-- App Icon / Logo Image Upload -->
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-[#141413] dark:text-[#faf9f5] mb-2 font-sans">
              App Icon Graphic (Optional CLIP Cosine Match)
            </label>
            <div class="flex items-center gap-3">
              <label class="flex-1 border-2 border-dashed border-[#e6dfd8] dark:border-[#2d2b26] hover:border-[#cc785c] bg-[#faf9f5] dark:bg-[#121110] px-4 py-2.5 rounded-2xl cursor-pointer flex items-center justify-between text-xs text-[#78756d] font-mono transition-colors">
                <span id="upload-label">📎 Drag or choose app logo icon</span>
                <input type="file" id="icon-file-input" accept="image/*" class="hidden" />
              </label>
              <div id="image-preview" class="w-12 h-12 border border-[#e6dfd8] dark:border-[#2d2b26] bg-[#faf9f5] dark:bg-[#121110] flex items-center justify-center shrink-0 rounded-2xl overflow-hidden text-[9px] text-[#78756d] font-mono shadow-xs">
                NO IMG
              </div>
            </div>
          </div>
        </div>

        <!-- Sample Links & Submit Action -->
        <div class="pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="text-[#78756d] font-bold uppercase text-[10px] tracking-wider mr-1">Try Known Store Links:</span>
            <button
              type="button"
              id="preset-rogue-bytexl"
              class="preset-btn px-3 py-1.5 bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-[11px] font-mono rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all cursor-pointer btn-3d-pop"
            >
              ByteXL Placement Phishing APK
            </button>
            <button
              type="button"
              id="preset-sideload-apk"
              class="preset-btn px-3 py-1.5 bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-[11px] font-mono rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all cursor-pointer btn-3d-pop"
            >
              Third-Party Sideload Mirror
            </button>
            <button
              type="button"
              id="preset-official-app"
              class="preset-btn px-3 py-1.5 bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-[11px] font-mono rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all cursor-pointer btn-3d-pop"
            >
              Official Verified ByteXL App
            </button>
          </div>

          <button
            type="submit"
            id="run-scan-btn"
            class="bg-[#cc785c] hover:bg-[#b86348] text-white text-xs sm:text-sm font-bold px-8 py-3.5 rounded-2xl shadow-md shadow-[#cc785c]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop btn-3d-coral cursor-pointer shrink-0"
          >
            <span id="scan-spinner" class="hidden flex items-center gap-2">
              <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
              <span>Executing 5-Pillar Diagnostics...</span>
            </span>
            <span id="scan-btn-text" class="flex items-center gap-1.5">
              <span>Execute 5-Pillar Audit</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </span>
          </button>
        </div>

      </form>

      <!-- Live Scan Error Banner -->
      <div id="app-scan-error-banner" class="hidden mt-4 p-4 rounded-2xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-red-800 dark:text-red-200 text-xs flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <svg class="w-5 h-5 text-red-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span id="app-scan-error-message" class="font-medium">Backend connection error. Please verify the FastAPI service is active.</span>
        </div>
        <button id="close-app-error-banner" type="button" class="text-red-600 hover:text-red-800 font-bold px-2 py-1 rounded-lg">✕</button>
      </div>
    </div>

    <!-- 3. FORENSIC SCORECARD & RESULTS DOSSIER -->
    <div id="app-results-section" class="space-y-8">
      
      <!-- Top Scoreboard Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-[#e6dfd8] dark:border-[#2d2b26]">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#cc785c] animate-ping"></span>
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#cc785c]">
              CASE #<span id="app-case-id">GP-884920</span> // STORE AUDIT DOSSIER
            </span>
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold tracking-tight text-[#141413] dark:text-[#faf9f5] mt-0.5">
            5-Pillar Mobile Risk Scoreboard
          </h2>
        </div>

        <button id="open-takedown-btn" type="button" class="bg-[#c64545] hover:bg-[#a83636] text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-2xl shadow-md transition-all flex items-center gap-2 btn-3d-pop cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>1-Click App Store Abuse Strike</span>
        </button>
      </div>

      <!-- Publisher Mismatch Alert Banner -->
      <div id="publisher-mismatch-banner" class="bg-red-50 dark:bg-red-950/40 border-2 border-red-500/40 rounded-3xl p-5 flex items-start gap-3.5">
        <div class="w-8 h-8 rounded-xl bg-red-500/20 text-red-500 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <div>
          <h4 class="font-serif text-base font-bold text-red-700 dark:text-red-300">Rogue Publisher Impersonation Detected</h4>
          <p id="publisher-alert-text" class="text-xs text-[#78756d] dark:text-[#a09d96] mt-0.5 leading-relaxed font-mono">
            App published by unauthorized developer 'Apex Global Studio LLC' mimicking protected enterprise 'ByteXL'.
          </p>
        </div>
      </div>

      <!-- Upper Row: Threat Meter & App Info Card -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
        
        <!-- App Threat Index Gauge -->
        <div class="md:col-span-5 bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 sm:p-8 flex flex-col justify-between items-center text-center shadow-xs card-lift">
          <div class="w-full">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#78756d] dark:text-[#8e8b82] block mb-2">
              App Store Forensic Threat Index
            </span>
            <div class="my-4">
              <div id="app-threat-index" class="font-serif text-6xl sm:text-7xl font-bold text-[#c64545] dark:text-[#f87171] tracking-tight">
                88.4
              </div>
              <div class="text-[11px] text-[#78756d] font-mono mt-1">out of 100 composite threshold</div>
            </div>
          </div>

          <div class="w-full space-y-3">
            <div id="app-severity-badge" class="px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border border-red-200 dark:border-red-900 inline-block w-full">
              CRITICAL THREAT LEVEL
            </div>
            <p id="app-recommended-action" class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
              Confirmed Rogue Impersonator — Immediate Store Takedown Strike Warranted
            </p>
          </div>
        </div>

        <!-- Target App Metadata Details -->
        <div class="md:col-span-7 bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 sm:p-8 flex flex-col justify-between shadow-xs card-lift">
          <div>
            <div class="flex items-center justify-between pb-4 border-b border-[#e6dfd8]/60 dark:border-[#24221e]">
              <div class="flex items-center gap-3">
                <div id="dossier-icon" class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#cc785c] to-[#a9583e] text-white flex items-center justify-center font-bold text-lg overflow-hidden shrink-0 shadow-xs">
                  📱
                </div>
                <div>
                  <h3 id="res-app-title" class="font-serif text-xl sm:text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">
                    ByteXL Placement Exam & Student Desk
                  </h3>
                  <div class="flex items-center gap-2 mt-0.5 text-xs text-[#78756d] font-mono">
                    <span id="res-store-name">Google Play</span>
                    <span>•</span>
                    <span id="res-publisher-name" class="text-[#cc785c] font-bold">Apex Global Studio LLC</span>
                  </div>
                </div>
              </div>

              <span class="text-[10px] font-mono bg-[#cc785c]/15 text-[#cc785c] px-2.5 py-1 rounded-full font-bold">
                AUDITED
              </span>
            </div>

            <!-- Package Details Grid -->
            <div class="grid grid-cols-2 gap-3 mt-4 text-xs font-mono">
              <div class="p-3 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26]">
                <span class="text-[10px] uppercase font-bold text-[#78756d] block mb-0.5">Package ID:</span>
                <span id="res-package-id" class="font-bold text-[#141413] dark:text-[#faf9f5] truncate block">com.bytexl.placement.guide</span>
              </div>
              <div class="p-3 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26]">
                <span class="text-[10px] uppercase font-bold text-[#78756d] block mb-0.5">Version & Build:</span>
                <span class="font-bold text-[#141413] dark:text-[#faf9f5]">v1.0.4 (Signed)</span>
              </div>
              <div class="p-3 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26]">
                <span class="text-[10px] uppercase font-bold text-[#78756d] block mb-0.5">Reported Downloads:</span>
                <span class="font-bold text-[#141413] dark:text-[#faf9f5]">10,000+ Installs</span>
              </div>
              <div class="p-3 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26]">
                <span class="text-[10px] uppercase font-bold text-[#78756d] block mb-0.5">SMS Permissions:</span>
                <span class="font-bold text-[#c64545]">READ_SMS + RECEIVE_SMS</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between text-xs font-mono text-[#78756d]">
            <span>Algorithm: Automated 5-Pillar Model</span>
            <span class="text-[#5db872] font-bold">FastAPI Connected</span>
          </div>
        </div>

      </div>

      <!-- Lower Row: 5 Diagnostic Pillars Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Pillar 1: AI Bot Reviews -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 shadow-xs card-lift space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#cc785c]">PILLAR 1: REVIEWS</span>
            <span id="p1-bot-score" class="font-serif text-xl font-bold text-[#c64545]">88.5% AI</span>
          </div>
          <h4 class="font-serif text-base font-bold text-[#141413] dark:text-[#faf9f5]">AI Bot Review Synthesis</h4>
          <p class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
            Repetitive phrase structures and low perplexity text scores identify astroturfed LLM review generation.
          </p>
          <div class="text-[11px] font-mono text-[#78756d] bg-[#faf9f5] dark:bg-[#121110] p-2.5 rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26]">
            Pattern: <strong id="p1-bot-pattern" class="text-[#c64545]">Synthesized Praise</strong>
          </div>
        </div>

        <!-- Pillar 2: Astroturfing Burst -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 shadow-xs card-lift space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#e8a55a]">PILLAR 2: VELOCITY</span>
            <span id="p2-burst-score" class="font-serif text-xl font-bold text-[#c64545]">24h Window</span>
          </div>
          <h4 class="font-serif text-base font-bold text-[#141413] dark:text-[#faf9f5]">Astroturfing Burst Velocity</h4>
          <p class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
            Coordinated surges where positive ratings were artificially posted inside a tight time window.
          </p>
          <div class="text-[11px] font-mono text-[#78756d] bg-[#faf9f5] dark:bg-[#121110] p-2.5 rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26]">
            Burst: <strong id="p2-burst-pattern" class="text-[#c64545]">Coordinated Campaign</strong>
          </div>
        </div>

        <!-- Pillar 3: Publisher OSINT -->
        <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 shadow-xs card-lift space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold uppercase tracking-wider text-[#5db872]">PILLAR 3: DEVELOPER</span>
            <span id="p3-pub-score" class="font-serif text-xl font-bold text-[#c64545]">18d avg lifespan</span>
          </div>
          <h4 class="font-serif text-base font-bold text-[#141413] dark:text-[#faf9f5]">Publisher Reverse OSINT</h4>
          <p class="text-xs text-[#78756d] dark:text-[#8e8b82] leading-relaxed">
            Developer account evaluated across cross-store records for disposable clone applications.
          </p>
