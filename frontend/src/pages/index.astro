<script>
  import { apiFetch } from '../lib/api';

  // --- Guided Tour Modal Functionality ---
  const tourModal = document.getElementById('tour-modal');
  const openTourBtn = document.getElementById('open-tour-btn');
  const closeTourBtn = document.getElementById('close-tour-modal-btn');
  const tourPrevBtn = document.getElementById('tour-prev-btn') as HTMLButtonElement;
  const tourNextBtn = document.getElementById('tour-next-btn') as HTMLButtonElement;
  const tourStepBadge = document.getElementById('tour-step-badge');
  const tourStepSubtitle = document.getElementById('tour-step-subtitle');
  const tourSlides = document.querySelectorAll('.tour-slide');
  const tourDots = document.getElementById('tour-dots-indicator')?.querySelectorAll('span');

  let currentTourSlide = 1;
  const totalTourSlides = 4;

  const subtitles = [
    "System Overview",
    "Computer Vision",
    "NLP Deobfuscation",
    "1-Click Takedown"
  ];

  function showTourSlide(slideNum: number) {
    currentTourSlide = slideNum;
    tourSlides.forEach((slide) => {
      const num = parseInt(slide.getAttribute('data-slide') || '1');
      slide.classList.toggle('hidden', num !== currentTourSlide);
    });

    if (tourStepBadge) tourStepBadge.textContent = `Step ${currentTourSlide} of ${totalTourSlides}`;
    if (tourStepSubtitle) tourStepSubtitle.textContent = subtitles[currentTourSlide - 1];

    if (tourPrevBtn) tourPrevBtn.disabled = currentTourSlide === 1;
    if (tourNextBtn) tourNextBtn.textContent = currentTourSlide === totalTourSlides ? "Finish Tour ✓" : "Next →";

    tourDots?.forEach((dot, idx) => {
      if (idx === currentTourSlide - 1) {
        dot.className = "w-2.5 h-2.5 rounded-full bg-[#cc785c]";
      } else {
        dot.className = "w-2 h-2 rounded-full bg-[#e6dfd8] dark:bg-[#2d2b26]";
      }
    });
  }

  openTourBtn?.addEventListener('click', () => {
    showTourSlide(1);
    tourModal?.classList.remove('hidden');
  });

  closeTourBtn?.addEventListener('click', () => {
    tourModal?.classList.add('hidden');
  });

  tourPrevBtn?.addEventListener('click', () => {
    if (currentTourSlide > 1) showTourSlide(currentTourSlide - 1);
  });

  tourNextBtn?.addEventListener('click', () => {
    if (currentTourSlide < totalTourSlides) {
      showTourSlide(currentTourSlide + 1);
    } else {
      tourModal?.classList.add('hidden');
    }
  });

  tourModal?.addEventListener('click', (e) => {
    if (e.target === tourModal) tourModal?.classList.add('hidden');
  });

  // --- Social Media Link Scanner Functionality ---
  const form = document.getElementById('social-scan-form') as HTMLFormElement;
  const linkInput = document.getElementById('link_input') as HTMLInputElement;
  const submitBtn = document.getElementById('scan-submit-btn') as HTMLButtonElement;
  const spinner = document.getElementById('scan-spinner');
  const btnText = document.getElementById('scan-btn-text');
  const openTakedownBtn = document.getElementById('open-takedown-btn') as HTMLButtonElement;
  const takedownModal = document.getElementById('takedown-modal');
  const sampleBtns = document.querySelectorAll('.sample-btn');

  // Auto-detect brand from URL or handle
  function autoDetectBrand(urlOrHandle: string): string {
    const lower = urlOrHandle.toLowerCase();
    if (lower.includes('zomato') || lower.includes('z0mato') || lower.includes('zomto')) return 'Zomato';
    if (lower.includes('paytm') || lower.includes('paytrn') || lower.includes('pay_tm')) return 'Paytm';
    if (lower.includes('zerodha') || lower.includes('zer0dha')) return 'Zerodha';
    if (lower.includes('kampus')) return 'Kampus.vc';
    if (lower.includes('bytexl') || lower.includes('byte_xl')) return 'ByteXL';
    return ''; // Backend auto-detects brand or generic scam desk
  }

  // Wire sample link buttons
  sampleBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url') || '';
      linkInput.value = url;
      form.requestSubmit();
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (spinner && btnText) {
      spinner.classList.remove('hidden');
      btnText.classList.add('hidden');
    }
    if (submitBtn) submitBtn.disabled = true;

    const urlOrHandle = linkInput.value.trim();
    const brandName = autoDetectBrand(urlOrHandle);

    try {
      // 1. Direct automated extraction from backend
      let extractedData: any = {};
      try {
        extractedData = await apiFetch<any>('/api/v1/extract-link', {
          method: 'POST',
          body: JSON.stringify({ url: urlOrHandle })
        });
      } catch (err) {
        console.warn("Direct extract endpoint note, continuing with scan...", err);
      }

      // 2. Multi-modal scan
      const scanPayload = {
        brand_name: brandName || "Auto-Detect",
        suspect_url: urlOrHandle.startsWith('http') ? urlOrHandle : `https://instagram.com/${urlOrHandle.replace('@', '')}`,
        suspect_handle: extractedData.extracted_handle || (urlOrHandle.startsWith('@') ? urlOrHandle : `@${urlOrHandle.split('/').filter(Boolean).pop()}`),
        platform: extractedData.platform || (urlOrHandle.includes('x.com') ? 'X' : urlOrHandle.includes('t.me') ? 'Telegram' : 'Instagram'),
        suspect_bio: extractedData.bio || ""
      };

      const result = await apiFetch<any>('/api/v1/scan', {
        method: 'POST',
        body: JSON.stringify(scanPayload)
      });

      // Clear any prior error
      document.getElementById('scan-error-banner')?.classList.add('hidden');
      renderResults(result);
    } catch (err: any) {
      console.error("Forensic scan error:", err);
      const errBanner = document.getElementById('scan-error-banner');
      const errMsg = document.getElementById('scan-error-message');
      if (errBanner && errMsg) {
        errMsg.textContent = `Scan failed: ${err.message || 'Unable to connect to AegisMark AI backend at http://127.0.0.1:8000. Please ensure the backend is running.'}`;
        errBanner.classList.remove('hidden');
        errBanner.scrollIntoView({ behavior: 'smooth' });
      }
    } finally {
      if (spinner && btnText) {
        spinner.classList.add('hidden');
        btnText.classList.remove('hidden');
      }
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  // Close error banner handler
  document.getElementById('close-error-banner')?.addEventListener('click', () => {
    document.getElementById('scan-error-banner')?.classList.add('hidden');
  });

  function renderResults(data: any) {
    const resultsSec = document.getElementById('social-results');
    resultsSec?.scrollIntoView({ behavior: 'smooth' });

    (document.getElementById('res-scan-id') as HTMLElement).textContent = data.scan_id;
    (document.getElementById('res-action') as HTMLElement).textContent = data.recommended_action;
    (document.getElementById('res-handle') as HTMLElement).textContent = data.suspect_handle;
    (document.getElementById('res-url') as HTMLElement).textContent = data.suspect_url;
    (document.getElementById('res-platform') as HTMLElement).textContent = data.platform;

    // Avatar Initial
    const avatarInit = document.getElementById('res-avatar-initial');
    if (avatarInit && data.suspect_handle) {
      avatarInit.textContent = data.suspect_handle.replace('@', '').charAt(0).toUpperCase() || '@';
    }

    // Brand Profile & Domain resolution
    const brandName = data.brand_profile?.brand_name || data.brand_name || "None";
    const brandLower = brandName.toLowerCase();
    const isIndependent = brandLower.includes("none") || brandLower.includes("personal profile");
    const isGenericScam = brandLower.includes("scam desk") || brandLower.includes("leak desk") || brandLower.includes("phishing") || brandLower.includes("unauthorized");

    const brandElem = document.getElementById('res-brand') as HTMLElement;
    if (brandElem) {
      if (isGenericScam) {
        brandElem.textContent = brandName;
        brandElem.className = "text-[#c64545] font-bold";
      } else if (isIndependent) {
        brandElem.textContent = "None (Personal Profile)";
        brandElem.className = "text-[#78756d] font-medium";
      } else {
        brandElem.textContent = brandName;
        brandElem.className = "text-[#cc785c] font-bold";
      }
    }

    const domainElem = document.getElementById('res-official-domain') as HTMLElement;
    if (domainElem) {
      if (isGenericScam) {
        domainElem.textContent = "Unregistered / Rogue Entity";
        domainElem.className = "truncate block font-bold text-[#c64545]";
      } else if (isIndependent) {
        domainElem.textContent = "N/A (Personal Account)";
        domainElem.className = "truncate block font-bold text-[#78756d]";
      } else {
        domainElem.textContent = data.brand_profile?.official_domain || `${brandName.toLowerCase()}.com`;
        domainElem.className = "truncate block font-bold text-[#5db872]";
      }
    }

    const officialHandleElem = document.getElementById('res-official-handle') as HTMLElement;
    if (officialHandleElem) {
      if (isGenericScam) {
        officialHandleElem.textContent = "Unauthorized Authority Spoof";
        officialHandleElem.className = "truncate block font-bold text-[#c64545]";
      } else if (isIndependent) {
        officialHandleElem.textContent = "N/A (Personal Account)";
        officialHandleElem.className = "truncate block font-bold text-[#78756d]";
      } else {
        officialHandleElem.textContent = data.brand_profile?.official_handle || `@${brandName.toLowerCase()}_official`;
        officialHandleElem.className = "truncate block font-bold text-[#5db872]";
      }
    }

    // Bio Copy — Display actual scraped text or clean notice, NEVER fake hardcoded scam text!
    const bioElem = document.getElementById('res-bio') as HTMLElement;
    if (bioElem) {
      if (data.suspect_bio && data.suspect_bio.trim().length > 0) {
        bioElem.textContent = data.suspect_bio;
        bioElem.classList.remove('italic', 'text-[#78756d]');
      } else {
        bioElem.textContent = "No public bio text found on profile (Standard personal profile / Private account).";
        bioElem.classList.add('italic', 'text-[#78756d]');
      }
    }

    // Account Age & Description Style Telemetry (Dedicated widgets outside bio copy)
    const ageElem = document.getElementById('res-account-age');
    const predElem = document.getElementById('res-account-pred');
    const ageBadge = document.getElementById('res-account-age-badge');
    const styleElem = document.getElementById('res-desc-style');
    const styleScoreElem = document.getElementById('res-desc-style-score');
    const styleBadge = document.getElementById('res-desc-style-badge');

    if (ageElem) {
      ageElem.textContent = data.account_age_label || `${data.account_age_days || 3} Days Old`;
    }
    if (predElem) {
      predElem.textContent = data.account_creation_predicted || "Recent (2026)";
    }
    if (ageBadge) {
      const ageRisk = data.account_age_risk_score ?? (scoreVal >= 70 ? 88 : 10);
      if (ageRisk >= 70) {
        ageBadge.textContent = "High-Risk Burner";
        ageBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/30 uppercase";
      } else if (ageRisk >= 30) {
        ageBadge.textContent = "Moderate Longevity";
        ageBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 uppercase";
      } else {
        ageBadge.textContent = "Matured Profile";
        ageBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 uppercase";
      }
    }

    if (styleElem) {
      styleElem.textContent = data.description_style || "Natural Social Narrative";
    }
    if (styleScoreElem) {
      const styleScore = Math.round(data.description_style_score ?? (scoreVal >= 70 ? 92 : 0));
      styleScoreElem.textContent = `${styleScore}.0 / 100`;
      styleScoreElem.className = styleScore >= 70 ? "text-rose-600 dark:text-rose-400 font-bold" : styleScore >= 30 ? "text-amber-600 dark:text-amber-400 font-bold" : "text-emerald-600 dark:text-emerald-400 font-bold";
    }
    if (styleBadge) {
      const cat = data.description_style_category || (scoreVal >= 70 ? "HIGH_RISK_SCAM_STYLE" : "AUTHENTIC_PERSONAL");
      if (cat === "HIGH_RISK_SCAM_STYLE") {
        styleBadge.textContent = "High Scam Style";
        styleBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-600 dark:text-rose-400 border border-rose-500/30 uppercase";
      } else if (cat === "FAN_COMMUNITY") {
        styleBadge.textContent = "Community Style";
        styleBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 uppercase";
      } else {
        styleBadge.textContent = "Authentic Style";
        styleBadge.className = "text-[9px] font-mono font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 uppercase";
      }
    }

    // Threat Score & Badge formatting
    const scoreVal = Math.round(data.unified_threat_score || 0);
    const scoreElem = document.getElementById('res-score') as HTMLElement;
    if (scoreElem) {
      scoreElem.textContent = scoreVal.toFixed(1);
      if (scoreVal >= 70) {
        scoreElem.className = "font-serif text-6xl sm:text-7xl font-bold text-[#c64545] dark:text-[#f87171] tracking-tight";
      } else if (scoreVal >= 40) {
        scoreElem.className = "font-serif text-6xl sm:text-7xl font-bold text-[#e8a55a] dark:text-[#e8a55a] tracking-tight";
      } else {
        scoreElem.className = "font-serif text-6xl sm:text-7xl font-bold text-[#5db872] dark:text-[#5db872] tracking-tight";
      }
    }

    const badge = document.getElementById('res-badge') as HTMLElement;
    const statusDot = document.getElementById('res-status-dot') as HTMLElement;
    if (badge) {
      if (data.severity_level === 'CRITICAL' || scoreVal >= 90) {
        badge.textContent = "CRITICAL THREAT LEVEL";
        badge.className = "px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl bg-red-100 text-red-700 dark:bg-red-950/60 dark:text-red-300 border border-red-200 dark:border-red-900 inline-block w-full";
        if (statusDot) statusDot.className = "w-2 h-2 rounded-full bg-[#c64545] animate-ping";
      } else if (data.severity_level === 'HIGH' || scoreVal >= 70) {
        badge.textContent = "HIGH THREAT LEVEL";
        badge.className = "px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-200 dark:border-amber-900 inline-block w-full";
        if (statusDot) statusDot.className = "w-2 h-2 rounded-full bg-[#e8a55a]";
      } else if (data.severity_level === 'MEDIUM' || scoreVal >= 40) {
        badge.textContent = "MEDIUM RISK";
        badge.className = "px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl bg-yellow-100 text-yellow-800 dark:bg-yellow-950/60 dark:text-yellow-300 border border-yellow-200 dark:border-yellow-900 inline-block w-full";
        if (statusDot) statusDot.className = "w-2 h-2 rounded-full bg-[#e8a55a]";
      } else {
        badge.textContent = "CLEAN / BENIGN (0.0 THREAT)";
        badge.className = "px-4 py-2 font-bold text-xs uppercase tracking-wider rounded-xl bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-900 inline-block w-full";
        if (statusDot) statusDot.className = "w-2 h-2 rounded-full bg-emerald-500";
      }
    }

    // Pillar Scores
    const p1 = Math.round(data.pillar_1_vision?.score || 0);
    const p2 = Math.round(data.pillar_2_nlp?.score || 0);
    const p3 = Math.round(data.pillar_3_heuristics?.score || 0);

    const p1ScoreElem = document.getElementById('p1-score');
    if (p1ScoreElem) {
      p1ScoreElem.textContent = `${p1}%`;
      p1ScoreElem.className = `font-serif text-2xl font-bold ${p1 >= 70 ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }
    const p2ScoreElem = document.getElementById('p2-score');
    if (p2ScoreElem) {
      p2ScoreElem.textContent = `${p2}%`;
      p2ScoreElem.className = `font-serif text-2xl font-bold ${p2 >= 70 ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }
    const p3ScoreElem = document.getElementById('p3-score');
    if (p3ScoreElem) {
      p3ScoreElem.textContent = `${p3}%`;
      p3ScoreElem.className = `font-serif text-2xl font-bold ${p3 >= 70 ? 'text-[#c64545]' : 'text-[#5db872]'}`;
    }

    // Takedown Action Button Status
    if (openTakedownBtn) {
      if (scoreVal >= 70 || data.takedown_unlocked) {
        openTakedownBtn.disabled = false;
        openTakedownBtn.className = "bg-[#c64545] hover:bg-[#a83636] text-white text-xs sm:text-sm font-bold px-5 py-2.5 rounded-2xl shadow-md transition-all flex items-center gap-2 btn-3d-pop cursor-pointer opacity-100";
        openTakedownBtn.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <span>Generate Legal Takedown Notice</span>
        `;
      } else {
        openTakedownBtn.disabled = true;
        openTakedownBtn.className = "bg-[#78756d]/30 text-[#78756d] text-xs sm:text-sm font-bold px-5 py-2.5 rounded-2xl transition-all flex items-center gap-2 cursor-not-allowed opacity-60";
        openTakedownBtn.innerHTML = `
          <svg class="w-4 h-4 text-[#5db872]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Clean Profile (Takedown Inactive)</span>
        `;
      }
    }

    // Flags List
    const flagsList = document.getElementById('res-flags');
    if (flagsList && data.flags) {
      const isClean = scoreVal < 40;
      flagsList.innerHTML = data.flags.map((f: string) => `
        <li class="p-3 bg-[#faf9f5] dark:bg-[#121110] rounded-xl border-l-4 ${isClean ? 'border-[#5db872]' : 'border-[#c64545]'} text-[#141413] dark:text-[#faf9f5]">
          ${isClean ? '✓' : '⚠'} ${f}
        </li>
      `).join('');
    }

    // Render Multi-Modal Recent Posts (Image OCR + Voiceover Speech Transcripts)
    const postsGrid = document.getElementById('res-posts-grid');
    const postsCountBadge = document.getElementById('posts-count-badge');
    if (postsGrid) {
      if (data.recent_posts && data.recent_posts.length > 0) {
        if (postsCountBadge) postsCountBadge.textContent = `${data.recent_posts.length} Posts Inspected`;
        postsGrid.innerHTML = data.recent_posts.map((post: any) => {
          const isThreat = post.post_threat_flag || (post.audio_threat_score && post.audio_threat_score >= 60);
          return `
            <div class="bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-2xl overflow-hidden card-lift flex flex-col justify-between shadow-2xs">
              <div>
                <!-- Image Header with Threat Tag -->
                <div class="relative h-44 w-full bg-[#e6dfd8]/30 overflow-hidden">
                  <img
                    src="${post.image_url || 'https://images.unsplash.com/photo-1554224155-8d04cb21cd6c?w=600'}"
                    alt="Post Evidence"
                    class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold font-mono tracking-wider uppercase ${isThreat ? 'bg-red-600 text-white' : 'bg-emerald-600 text-white'} shadow-xs">
                      ${isThreat ? '⚠ PHISHING / FRAUD' : '✓ BENIGN POST'}
                    </span>
                  </div>
                  <div class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-full text-[10px] font-mono bg-black/70 text-white backdrop-blur-xs">
                    ${post.posted_date || 'Recent'}
                  </div>
                </div>

                <!-- Post Body Content -->
                <div class="p-4 space-y-3">
                  <!-- Caption -->
                  <div>
                    <span class="text-[10px] uppercase font-bold text-[#78756d] block mb-1">Caption Copy:</span>
                    <p class="text-xs text-[#141413] dark:text-[#faf9f5] font-sans line-clamp-3 leading-relaxed">
                      ${post.caption || '(No caption text)'}
                    </p>
                  </div>

                  <!-- OCR Extracted Overlay -->
                  <div class="p-2.5 rounded-xl bg-white dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26]">
                    <div class="flex items-center justify-between text-[10px] font-mono text-[#cc785c] font-bold mb-1">
                      <span>📸 IMAGE OCR EXTRACT:</span>
                    </div>
                    <p class="text-[11px] font-mono ${isThreat ? 'text-[#c64545] font-semibold' : 'text-[#78756d]'} leading-snug">
                      ${post.ocr_extracted_text || 'No text detected in graphic'}
                    </p>
                  </div>

                  <!-- Audio & Voiceover Transcript -->
                  <div class="p-2.5 rounded-xl bg-white dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26]">
                    <div class="flex items-center justify-between text-[10px] font-mono mb-1">
                      <span class="text-[#3b82f6] font-bold">🎙 AUDIO / VOICEOVER:</span>
                      <span class="font-bold ${post.audio_threat_score >= 60 ? 'text-[#c64545]' : 'text-[#5db872]'}">
                        ${post.audio_threat_score ? post.audio_threat_score.toFixed(0) : '0'}% Risk
                      </span>
                    </div>
                    <div class="text-[10px] text-[#78756d] truncate font-mono mb-1">Track: ${post.audio_track || 'Original Audio'}</div>
                    <p class="text-[11px] font-mono text-[#141413] dark:text-[#faf9f5] line-clamp-3 italic">
                      ${post.audio_transcript || 'No voiceover speech detected'}
                    </p>
                  </div>

                  <!-- Flagged Keywords Pills -->
                  ${post.flagged_keywords && post.flagged_keywords.length > 0 ? `
                    <div class="flex flex-wrap gap-1 pt-1">
                      ${post.flagged_keywords.map((kw: string) => `
                        <span class="px-2 py-0.5 rounded-md bg-red-100 dark:bg-red-950/60 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900 text-[10px] font-mono font-bold">
                          ${kw}
                        </span>
                      `).join('')}
                    </div>
                  ` : ''}
                </div>
              </div>

              <!-- Metrics Footer -->
              <div class="px-4 py-2.5 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between text-[11px] font-mono text-[#78756d]">
                <span>❤️ ${(post.likes_count || 0).toLocaleString()} likes</span>
                <span>💬 ${(post.comments_count || 0).toLocaleString()} comments</span>
              </div>
            </div>
          `;
        }).join('');
      } else {
        if (postsCountBadge) postsCountBadge.textContent = '0 Posts Found';
        postsGrid.innerHTML = `
          <div class="col-span-full py-8 text-center text-xs font-mono text-[#78756d]">
            No public posts could be extracted for this profile.
          </div>
        `;
      }
    }

    // Render Cross-Platform OSINT Footprint
    const footprintGrid = document.getElementById('res-footprint-grid');
    const footprintCountBadge = document.getElementById('footprint-count-badge');
    if (footprintGrid) {
      if (data.cross_platform_footprint && data.cross_platform_footprint.length > 0) {
        if (footprintCountBadge) footprintCountBadge.textContent = `${data.cross_platform_footprint.length} Platforms Checked`;
        footprintGrid.innerHTML = data.cross_platform_footprint.map((fp: any) => {
          const isHigh = fp.threat_level === 'HIGH' || fp.threat_level === 'CRITICAL';
          const isMedium = fp.threat_level === 'MEDIUM';
          const badgeClass = isHigh
            ? 'bg-red-100 text-red-800 dark:bg-red-950/60 dark:text-red-300 border-red-200 dark:border-red-900'
            : isMedium
            ? 'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300 border-amber-200 dark:border-amber-900'
            : 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border-emerald-200 dark:border-emerald-900';

          return `
            <div class="p-4 rounded-2xl bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] flex flex-col justify-between space-y-3 card-lift shadow-2xs">
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-bold text-[#141413] dark:text-[#faf9f5] font-serif">${fp.platform}</span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase border ${badgeClass}">
                    ${fp.threat_level}
                  </span>
                </div>
                <div class="font-mono text-xs font-bold text-[#cc785c] mt-1 truncate" title="${fp.handle_or_name}">
                  ${fp.handle_or_name}
                </div>
                <div class="text-[10px] font-mono text-[#78756d] mt-0.5 uppercase tracking-wide">
                  Status: <strong class="${isHigh ? 'text-[#c64545]' : 'text-[#5db872]'}">${fp.status.replace(/_/g, ' ')}</strong>
                </div>
                <p class="text-xs text-[#78756d] dark:text-[#8e8b82] mt-2 leading-relaxed">
                  ${fp.notes || 'No active anomalies identified.'}
                </p>
              </div>

              <div class="pt-2 border-t border-[#e6dfd8]/60 dark:border-[#24221e]">
                <a
                  href="${fp.url}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[11px] font-mono text-[#cc785c] hover:underline flex items-center justify-between"
                >
                  <span>Inspect Surface</span>
                  <span>↗</span>
                </a>
              </div>
            </div>
          `;
        }).join('');
      } else {
        if (footprintCountBadge) footprintCountBadge.textContent = '0 Surfaces';
        footprintGrid.innerHTML = `
          <div class="col-span-full py-8 text-center text-xs font-mono text-[#78756d]">
            No cross-platform presence discovered.
          </div>
        `;
      }
    }

    // Configure takedown text if impersonator
    if (scoreVal >= 70) {
      const takedownText = `FORMAL CEASE AND DESIST & TRADEMARK INFRINGEMENT NOTICE
Ref: CASE-${data.scan_id}
Notice To: Trust & Safety Legal Compliance, ${data.platform} Operations

RE: IMMEDIATE EXPEDITED TAKEDOWN OF UNLAWFUL IMPERSONATION ACCOUNT ${data.suspect_handle}

Dear Platform Legal Counsel,

We represent the proprietary corporate interests of ${data.brand_profile?.brand_name || data.brand_name}. This document constitutes a formal Demand for Immediate Takedown pursuant to 17 U.S.C. § 512(c).

I. INFRINGING DETAILS:
- Offending Handle: ${data.suspect_handle}
- Profile URL: ${data.suspect_url}
- Platform: ${data.platform}
- Composite Threat Level: ${data.severity_level} (${data.unified_threat_score}/100)

II. EVIDENCE CITATIONS:
1. Exact Visual Logomark Reproduction: Matched via 512-dim CLIP embedding space at ${(data.pillar_1_vision?.score || 95)}% similarity.
2. Advance-Fee Recruitment Fraud: DistilBERT NLP classifier verified solicitation of unauthorized monies.
3. Homoglyph Affix Manipulation: Target handle intentionally appends unauthorized designations (_official, _support).

Submitted by: AegisMark AI Cyber Operations`;

      const modalTextarea = document.getElementById('modal-takedown-text') as HTMLTextAreaElement;
      if (modalTextarea) modalTextarea.value = takedownText;
      const modalCaseId = document.getElementById('modal-case-id') as HTMLElement;
      if (modalCaseId) modalCaseId.textContent = `CASE-${data.scan_id}`;
    }
  }

  openTakedownBtn?.addEventListener('click', () => {
    if (!openTakedownBtn.disabled) {
      takedownModal?.classList.remove('hidden');
    }
  });
</script>
