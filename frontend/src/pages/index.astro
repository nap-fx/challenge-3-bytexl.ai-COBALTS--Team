---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TakedownModal from '../components/TakedownModal.astro';
---

<Layout title="AegisMark AI — Autonomous Brand Impersonation Defense" activeTab="social">
  
  <!-- Interactive Guided Tour Modal (Matching dailyhabs modal aesthetic) -->
  <div id="tour-modal" class="fixed inset-0 z-50 bg-[#121110]/70 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl max-w-xl w-full p-6 sm:p-8 shadow-2xl relative transform transition-all overflow-hidden">
      <div class="flex items-center justify-between pb-4 border-b border-[#e6dfd8]/60 dark:border-[#24221e]">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[#cc785c]/15 text-[#cc785c] border border-[#cc785c]/30" id="tour-step-badge">
            Step 1 of 4
          </span>
          <span class="text-xs text-[#78756d] dark:text-[#8e8b82] font-medium" id="tour-step-subtitle">System Overview</span>
        </div>
        <button id="close-tour-modal-btn" class="text-[#78756d] hover:text-[#141413] dark:hover:text-[#faf9f5] p-1.5 rounded-xl hover:bg-[#f4efe6] dark:hover:bg-[#24221e] transition-colors cursor-pointer" aria-label="Close tour">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="py-6 space-y-4">
        <!-- Slide 1 -->
        <div class="tour-slide" data-slide="1">
          <div class="w-14 h-14 rounded-2xl bg-[#cc785c]/15 text-[#cc785c] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">1. Zero-Friction Link Scraping</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed mt-2">
            Just paste any social handle or URL. The backend automatically extracts public avatars, biographical copy, account age, and links. No manual brand selection or parameter tuning is needed.
          </p>
        </div>

        <!-- Slide 2 -->
        <div class="tour-slide hidden" data-slide="2">
          <div class="w-14 h-14 rounded-2xl bg-[#5db872]/15 text-[#5db872] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">2. Computer Vision & Border Cropping</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed mt-2">
            Scammers often pad logos with black borders or slight rotations to evade hashes. Our vision pipeline automatically strips artificial padding and compares 512-dimensional CLIP embeddings against official trademarks.
          </p>
        </div>

        <!-- Slide 3 -->
        <div class="tour-slide hidden" data-slide="3">
          <div class="w-14 h-14 rounded-2xl bg-[#e8a55a]/15 text-[#e8a55a] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">3. NLP Intent & Deobfuscator</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed mt-2">
            Attackers hide keywords using zero-width spaces or Cyrillic characters. Our NLP engine strips obfuscation, analyzes text intent with DistilBERT, and detects illicit UPI IDs or credential traps.
          </p>
        </div>

        <!-- Slide 4 -->
        <div class="tour-slide hidden" data-slide="4">
          <div class="w-14 h-14 rounded-2xl bg-[#3b82f6]/15 text-[#3b82f6] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5]">4. 1-Click Signed Legal Takedowns</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] leading-relaxed mt-2">
            When threats are confirmed, the system immediately compiles an irrefutable legal DMCA dossier with cryptographic proof vectors ready to submit to Instagram, X, or Telegram legal teams.
          </p>
        </div>
      </div>

      <div class="pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between">
        <button id="tour-prev-btn" class="px-4 py-2 text-xs font-bold text-[#78756d] hover:bg-[#f4efe6] dark:hover:bg-[#24221e] rounded-xl transition-colors disabled:opacity-40 cursor-pointer" disabled>
          ← Previous
        </button>

        <div class="flex items-center gap-1.5" id="tour-dots-indicator">
          <span class="w-2.5 h-2.5 rounded-full bg-[#cc785c]"></span>
          <span class="w-2 h-2 rounded-full bg-[#e6dfd8] dark:bg-[#2d2b26]"></span>
          <span class="w-2 h-2 rounded-full bg-[#e6dfd8] dark:bg-[#2d2b26]"></span>
          <span class="w-2 h-2 rounded-full bg-[#e6dfd8] dark:bg-[#2d2b26]"></span>
        </div>

        <button id="tour-next-btn" class="bg-[#cc785c] hover:bg-[#b86348] text-white text-xs font-bold px-5 py-2 rounded-xl shadow-xs transition-all btn-3d-pop btn-3d-coral cursor-pointer">
          Next →
        </button>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 pt-6 pb-16 space-y-12">

    <!-- 1. EDITORIAL HERO & PRODUCT INTRODUCTION (dailyhabs warm canvas style) -->
    <section class="relative rounded-3xl bg-gradient-to-br from-[#ffffff] via-[#fbf9f4] to-[#f4efe6] dark:from-[#181715] dark:via-[#1c1b18] dark:to-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] p-8 sm:p-12 lg:p-14 shadow-xl overflow-hidden">
      
      <!-- Accent Glow Orbs -->
      <div class="absolute -right-20 -top-20 w-96 h-96 bg-[#cc785c]/15 dark:bg-[#cc785c]/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-96 h-96 bg-[#5db8a6]/12 dark:bg-[#5db8a6]/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#cc785c]/10 dark:bg-[#cc785c]/20 border border-[#cc785c]/30 text-[#cc785c] text-xs font-bold uppercase tracking-wider mb-6 shadow-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
          <span>Autonomous Digital Risk Protection</span>
        </div>

        <!-- Main Headline in Fraunces -->
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#141413] dark:text-[#faf9f5] leading-[1.1]">
          Stop Brand Impersonators. <br />
          <span class="text-[#cc785c] italic">Automate Legal Defense.</span>
        </h1>

        <!-- Subtitle in Plain English (No jargon, no filler) -->
        <p class="text-sm sm:text-base text-[#78756d] dark:text-[#8e8b82] mt-4 max-w-2xl font-medium leading-relaxed">
          AegisMark AI protects students, customers, and enterprises from fake support desks, phishing handles, and rogue apps. Simply paste any suspect profile or store link — our backend extracts public data, cross-examines trademarks with vision and NLP, and generates signed takedown packages.
        </p>

        <!-- Primary Action Launchers -->
        <div class="flex flex-wrap items-center gap-3.5 mt-8">
          <a href="#scanner-anchor" class="bg-[#cc785c] hover:bg-[#b86348] text-white text-xs sm:text-sm font-bold px-6 py-3.5 rounded-2xl shadow-lg shadow-[#cc785c]/25 transition-all flex items-center gap-2 btn-3d-pop btn-3d-coral">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
            <span>Scan Suspect Link</span>
          </a>

          <a href="/app-store" class="bg-[#181715] hover:bg-[#252320] text-white dark:bg-[#faf9f5] dark:text-[#141413] text-xs sm:text-sm font-bold px-6 py-3.5 rounded-2xl border border-[#33312c] dark:border-[#e6dfd8] transition-all flex items-center gap-2 btn-3d-pop">
            <svg class="w-4 h-4 text-[#cc785c]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <span>App Store Scanner →</span>
          </a>

          <button id="open-tour-btn" type="button" class="bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-xs sm:text-sm font-bold px-5 py-3.5 rounded-2xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all flex items-center gap-2 btn-3d-pop cursor-pointer">
            <svg class="w-4 h-4 text-[#e8a55a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            <span>How It Works (Tour)</span>
          </button>
        </div>

        <!-- Trust & Architecture Metrics -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-10 pt-8 border-t border-[#e6dfd8]/60 dark:border-[#24221e] text-xs font-semibold text-[#78756d] dark:text-[#8e8b82]">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#5db872]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
            <span>Zero Manual Entry</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#cc785c]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            <span>512-dim CLIP Vision</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#e8a55a]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>DistilBERT Deobfuscation</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#3b82f6]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>1-Click Signed DMCA</span>
          </div>
        </div>

      </div>

    </section>

    <!-- 2. THE THREE FORENSIC PILLARS (Clean Bento Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Vision -->
      <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#cc785c]/15 text-[#cc785c] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-[#cc785c]">Pillar 01</span>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5] mt-1">Computer Vision & Crop Stripping</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] mt-3 leading-relaxed">
            Extracts suspect avatar images, strips adversarial black border crops, and generates 512-dim CLIP embeddings to match against registered brand logos with cosine precision.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between text-xs font-mono text-[#78756d]">
          <span>Tolerance: &gt;90% Cosine</span>
          <span class="text-[#cc785c] font-bold">Auto-Padding Crop</span>
        </div>
      </div>

      <!-- Card 2: NLP Intent -->
      <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#5db872]/15 text-[#5db872] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          </div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-[#5db872]">Pillar 02</span>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5] mt-1">NLP Scam Intent & UPI Extraction</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] mt-3 leading-relaxed">
            Deobfuscates hidden zero-width characters and runs DistilBERT text classification to catch fraudulent fee solicitations, fake jobs, and unauthorized payment addresses.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between text-xs font-mono text-[#78756d]">
          <span>Deobfuscation: Zero-Width</span>
          <span class="text-[#5db872] font-bold">UPI Leak Flag</span>
        </div>
      </div>

      <!-- Card 3: Homoglyphs & Velocity -->
      <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-7 shadow-xs card-lift flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#3b82f6]/15 text-[#3b82f6] flex items-center justify-center mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
          </div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-[#3b82f6]">Pillar 03</span>
          <h3 class="font-serif text-2xl font-bold text-[#141413] dark:text-[#faf9f5] mt-1">Homoglyphs & Velocity Heuristics</h3>
          <p class="text-xs sm:text-sm text-[#78756d] dark:text-[#8e8b82] mt-3 leading-relaxed">
            Flags Cyrillic lookalikes (<code class="font-mono text-xs text-[#cc785c]">paytrn</code> vs <code class="font-mono text-xs">paytm</code>) and analyzes account follower velocity to distinguish viral posts from artificial bot purchases.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex items-center justify-between text-xs font-mono text-[#78756d]">
          <span>Distance: Levenshtein</span>
          <span class="text-[#3b82f6] font-bold">Spike Anomaly</span>
        </div>
      </div>

    </div>

    <!-- 3. THE SOCIAL SCANNER WORKFLOW (Pure Link Paster, Zero Manual Inputs) -->
    <div id="scanner-anchor" class="scroll-mt-24 space-y-8">
      
      <SectionHeader
        eyebrow="TAB 1 // INSTANT INVESTIGATION"
        title="Social Media Impersonator Scanner"
        subtitle="Paste any suspect Instagram, X, or Telegram link. The backend scrapes public evidence, detects targeted brands, runs all 3 diagnostic models, and renders the threat scoreboard."
      />

      <!-- Scanner Input Box -->
      <div class="bg-[#ffffff] dark:bg-[#1c1b18] border border-[#e6dfd8] dark:border-[#2d2b26] rounded-3xl p-6 sm:p-8 shadow-md">
        <form id="social-scan-form" class="space-y-5">
          <div>
            <label for="link_input" class="block text-xs font-bold uppercase tracking-wider text-[#141413] dark:text-[#faf9f5] mb-2 font-sans">
              Paste Suspect Profile URL or Handle
            </label>
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#78756d]">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                </div>
                <input
                  type="text"
                  id="link_input"
                  required
                  value="https://instagram.com/bytexl_support_official"
                  placeholder="e.g. https://instagram.com/bytexl_support_official or https://instagram.com/avilash_007"
                  class="w-full bg-[#faf9f5] dark:bg-[#121110] border border-[#e6dfd8] dark:border-[#2d2b26] pl-10 pr-4 py-3.5 rounded-2xl font-mono text-xs sm:text-sm text-[#141413] dark:text-[#faf9f5] outline-none focus:border-[#cc785c] transition-colors"
                />
              </div>
              <button
                type="submit"
                id="scan-submit-btn"
                class="bg-[#cc785c] hover:bg-[#b86348] text-white text-xs sm:text-sm font-bold px-8 py-3.5 rounded-2xl shadow-md shadow-[#cc785c]/25 transition-all flex items-center justify-center gap-2 btn-3d-pop btn-3d-coral cursor-pointer shrink-0"
              >
                <span id="scan-spinner" class="hidden flex items-center gap-2">
                  <svg class="animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
                  <span>Extracting Evidence...</span>
                </span>
                <span id="scan-btn-text" class="flex items-center gap-1.5">
                  <span>Run Forensic Scan</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </span>
              </button>
            </div>
          </div>

          <!-- Quick Paste Profile Links -->
          <div class="pt-3 border-t border-[#e6dfd8]/60 dark:border-[#24221e] flex flex-wrap items-center gap-2 text-xs">
            <span class="text-[#78756d] font-bold uppercase text-[10px] tracking-wider mr-1">Try Known Profiles:</span>
            <button
              type="button"
              class="sample-btn px-3 py-1.5 bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-[11px] font-mono rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all cursor-pointer btn-3d-pop"
              data-url="https://instagram.com/bytexl_support_official"
            >
              ByteXL Support Phishing Desk
            </button>
            <button
              type="button"
              class="sample-btn px-3 py-1.5 bg-[#f4efe6] dark:bg-[#24221e] hover:bg-[#ede6da] dark:hover:bg-[#2d2b26] text-[#141413] dark:text-[#faf9f5] text-[11px] font-mono rounded-xl border border-[#e6dfd8] dark:border-[#2d2b26] transition-all cursor-pointer btn-3d-pop"
              data-url="https://instagram.com/student_placement_desk"
            >
              Campus Placement Scam
            </button>
            <button
              type="button"
